{
	"private": true,
	"license": "MIT",
	"type": "module",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.13.1",
			"onFail": "download"
		}
	},
	"packageManager": "pnpm@10.30.0",
	"scripts": {
		"changeset:add": "changeset add",
		"changeset:status": "changeset status --verbose",
		"ci:release": "changeset publish",
		"ci:version": "changeset version && oxfmt --write",
		"format:check": "oxfmt --check",
		"format:fix": "oxfmt --write",
		"prepare": "run-s setup",
		"setup": "is-in-ci || simple-git-hooks",
		"types:check": "tsc --noEmit",
		"validate": "run-p format:check types:check"
	},
	"devDependencies": {
		"@acdh-oeaw/commitlint-config": "^3.0.0",
		"@acdh-oeaw/tsconfig-lib": "^1.3.0",
		"@changesets/changelog-github": "^0.5.2",
		"@changesets/cli": "^2.29.8",
		"@types/node": "^24.10.13",
		"is-in-ci": "^2.0.0",
		"lint-staged": "^16.2.7",
		"npm-run-all2": "^8.0.4",
		"oxfmt": "^0.33.0",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^5.9.3"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern --write"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm exec lint-staged",
		"pre-push": "pnpm run validate"
	}
}
